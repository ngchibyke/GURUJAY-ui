DATABASE_URL=postgres://market:market@localhost:5433/market
BIND_ADDR=127.0.0.1:8080
APP_ENV=development
RUST_LOG=info,tower_http=info
# 32-byte keys, standard base64 (generate: openssl rand -base64 32). Keep them different.
FIELD_KEY=
INDEX_KEY=
# Dev only: print OTP codes to stdout. Startup fails if set while APP_ENV=production.
OTP_DEV_ECHO=0
